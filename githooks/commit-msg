#!/usr/bin/env bash
# Commit message shape: type(scope): message, one line, no trailer.
set -uo pipefail
msg_file="$1"
# Ignore comment lines and merge commits.
subject=$(grep -v '^#' "$msg_file" | head -1)
body=$(grep -v '^#' "$msg_file" | tail -n +2 | grep -v '^[[:space:]]*$' || true)

red() { printf '\033[31m%s\033[0m\n' "$*"; }

case "$subject" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -qE '^(feat|fix|refactor|chore|docs|style|perf|test|ci|build)(\([a-z0-9,._-]+\))?: .{6,}$'; then
  red "commit refused: subject must be  type(scope): message"
  echo "  type: feat fix refactor chore docs style perf test ci build"
  echo "  got:  $subject"
  exit 1
fi

if [ ${#subject} -gt 100 ]; then
  red "commit refused: subject is ${#subject} characters, keep it under 100"
  exit 1
fi

if printf '%s' "$subject" | grep -q '—'; then
  red "commit refused: em dash in the subject"
  exit 1
fi

if printf '%s\n' "$body" | grep -qiE 'generated with|🤖'; then
  red "commit refused: no generator trailers in Nine history"
  exit 1
fi

# Co-authorship is for people. A ping-pong handover is real work by a second
# person, and the contribution graph is the only place that work shows, so the
# trailer is allowed and expected there. A tool that produced the diff is not an
# author: a trailer naming an assistant turns the graph into a fiction.
#
# The check is not on `Co-Authored-By` alone, because three ways past that
# version were found and all three passed it: `Claude-Session: https://x` names
# the tool in the key and never in the value, `Assisted-By: Claude <a@b.c>` uses
# a key nobody had enumerated, and two spaces in front of `Co-Authored-By:`
# defeated the `^` anchor. Git strips none of the three.
#
# So two rules instead of one list. A trailer whose KEY names a tool is refused
# whatever its value. A trailer whose key attributes authorship, anything ending
# in `-by` plus `author`, `authors` and `committer`, is refused when its VALUE
# names a tool. Splitting it this way is what keeps `Note: cursor position is
# wrong` and `Refs: AP4.1 cursor pagination` legal, which a single scan for the
# word would not.
tools='claude|anthropic|copilot|codex|cursor|chatgpt|openai|gemini|\[bot\]|bot@|noreply@'
attribution='^[[:space:]]*([A-Za-z][A-Za-z-]*-by|authors?|committer)[[:space:]]*:'

bad_key=$(printf '%s\n' "$body" | grep -iE "^[[:space:]]*[A-Za-z][A-Za-z-]*($tools)[A-Za-z-]*[[:space:]]*:" || true)
if [ -n "$bad_key" ] || printf '%s\n' "$body" | grep -iqE "^[[:space:]]*($tools)[A-Za-z-]*[[:space:]]*:"; then
  red "commit refused: a trailer key names a tool, and a tool is not an author"
  exit 1
fi

if printf '%s\n' "$body" | grep -iE "$attribution" | grep -qiE "$tools"; then
  red "commit refused: a co-author trailer names a person, not a tool"
  echo "  Co-Authored-By is for the other human who wrote part of this commit."
  exit 1
fi
